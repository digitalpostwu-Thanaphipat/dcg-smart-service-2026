# DCG Smart Service - ตัวอย่างไฟล์ Environment สำหรับ Staging
# คัดลอกไฟล์นี้เป็น .env.staging แล้วกรอกค่าจริง

# Staging Apps Script Web App URL (จะขึ้นต้นด้วย https://script.google.com/macros/s/.../exec)
VITE_API_URL=https://script.google.com/macros/s/YOUR_STAGING_SCRIPT_ID/exec

# ป้ายกำกับสภาพแวดล้อม (สำหรับ debug)
VITE_APP_ENV=staging
